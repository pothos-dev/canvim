      "x": -60,
      "y": 100,
      "width": 240,
      "height": 80,
      "text": "### connect\n`connectFromNodeId`\n`connectFromSide`",
      "color": "4"
    },
    {
      "id": "n000000search0000",
      "type": "text",
      "x": 200,
      "y": 100,
      "width": 240,
      "height": 80,
      "text": "### search\n`searchQuery`, `matchIds[]`\n`searchNext/Prev()`",
      "color": "4"
    },
    {
      "id": "n000000visual0000",
      "type": "text",
      "x": -60,
      "y": 200,
